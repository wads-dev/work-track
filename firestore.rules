rules_version = '2';

// Autorização do Firebase Web. O MCP usa Admin SDK e valida acesso no backend.
// Projetos exigem escopo explícito work/personal; confidencialidade é apresentação.
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. Identidade e invariantes mínimas
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isCurrentUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidUid(uid) {
      return uid is string && uid.size() > 0 && uid.size() <= 128;
    }

    function isValidDocumentId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function preservesFields(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isAuditAuthor() {
      return isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // 2. Projetos: acesso atual, descoberta e escritas
    // -------------------------------------------------------------------------
    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function isSharedProject(project) {
      return project.get('type', '') == 'work';
    }

    function isOwnPersonalProject(project) {
      return project.get('type', '') == 'personal'
        && isValidUid(project.get('createdBy', ''))
        && isCurrentUser(project.createdBy);
    }

    function canAccessProject(project) {
      return isAuthenticated()
        && (isSharedProject(project) || isOwnPersonalProject(project));
    }

    function canAccessProjectById(projectId) {
      return canAccessProject(get(projectPath(projectId)).data);
    }

    // Listagens usam os filtros explícitos das consultas Web. Rules não filtram
    // resultados: consulta work ou personal com createdBy próprio.
    // Nenhuma listagem ampla revela projetos pessoais de terceiros.
    function canDiscoverProject(project) {
      return isAuthenticated()
        && (project.get('type', '') == 'work'
          || (project.get('type', '') == 'personal'
            && project.get('createdBy', '') == request.auth.uid));
    }

    function isValidProject(project, projectId) {
      return isValidDocumentId(projectId)
        && project.id == projectId
        && (isSharedProject(project)
          || (project.type == 'personal'
            && isValidUid(project.get('createdBy', ''))));
    }

    function canCreateProject(projectId) {
      return isAuthenticated()
        && isValidProject(request.resource.data, projectId)
        && request.resource.data.get('createdBy', '') == request.auth.uid;
    }

    // A autorização usa o estado ANTERIOR. Tornar compartilhado -> pessoal pode
    // fazer o editor perder acesso após o commit; não muda a autoria do projeto.
    function canUpdateProject(projectId) {
      return canAccessProject(resource.data)
        && isValidProject(request.resource.data, projectId)
        && preservesFields(['id', 'createdBy']);
    }

    // -------------------------------------------------------------------------
    // 3. Auditoria de projeto: somente acréscimos, inclusive em transações
    // -------------------------------------------------------------------------
    function isValidProjectAfterWrite(projectId) {
      return isValidProject(getAfter(projectPath(projectId)).data, projectId);
    }

    function isCreatingOwnProject(projectId) {
      return !exists(projectPath(projectId))
        && getAfter(projectPath(projectId)).data.createdBy == request.auth.uid;
    }

    function canAuditExistingProject(projectId) {
      let before = get(projectPath(projectId)).data;
      let after = getAfter(projectPath(projectId)).data;
      return canAccessProject(before)
        && after.get('createdBy', '') == before.get('createdBy', '');
    }

    // getAfter vê o projeto no fim do batch. Acesso ao estado anterior permite
    // gravar auditoria mesmo quando o autor perde acesso ao mudar o escopo.
    function canCreateProjectAudit(projectId) {
      return isAuditAuthor()
        && isValidProjectAfterWrite(projectId)
        && (isCreatingOwnProject(projectId) || canAuditExistingProject(projectId));
    }

    // -------------------------------------------------------------------------
    // 4. Registros: leitura pelo projeto atual, escrita somente pelo dono
    // -------------------------------------------------------------------------
    // Snapshots históricos não concedem acesso. Projetos ausentes são negados.
    function canAccessRecordProject(record) {
      return isValidDocumentId(record.get('projectId', ''))
        && exists(projectPath(record.projectId))
        && canAccessProjectById(record.projectId);
    }

    function isValidRecord(record, ownerUid, recordId) {
      return isValidDocumentId(recordId)
        && record.uid == ownerUid
        && (!('id' in record) || record.id == recordId)
        && canAccessRecordProject(record);
    }

    function canCreateRecord(ownerUid, recordId) {
      return isCurrentUser(ownerUid)
        && isValidRecord(request.resource.data, ownerUid, recordId);
    }

    // Movimentos precisam autorizar origem e destino, sem trocar id ou dono.
    function canUpdateRecord(ownerUid, recordId) {
      return isCurrentUser(ownerUid)
        && resource.data.uid == ownerUid
        && canAccessRecordProject(resource.data)
        && isValidRecord(request.resource.data, ownerUid, recordId)
        && preservesFields(['id', 'uid']);
    }

    function canDeleteRecord(ownerUid) {
      return isCurrentUser(ownerUid)
        && resource.data.uid == ownerUid
        && canAccessRecordProject(resource.data);
    }

    function canCreateRecordAudit(ownerUid) {
      return isCurrentUser(ownerUid) && isAuditAuthor();
    }

    // -------------------------------------------------------------------------
    // 5. Coleções: regras curtas que expressam intenção
    // -------------------------------------------------------------------------
    match /projects/{projectId} {
      allow get: if isAuthenticated()
        && (!exists(projectPath(projectId)) || canAccessProject(resource.data));
      allow list: if canDiscoverProject(resource.data);
      allow create: if canCreateProject(projectId);
      allow update: if canUpdateProject(projectId);
      allow delete: if canAccessProject(resource.data);

      match /audit/{auditId} {
        allow read: if canAccessProjectById(projectId);
        allow create: if canCreateProjectAudit(projectId);
        allow update, delete: if false;
      }

      // União de tópicos é uma operação de backend; Web só consulta o histórico.
      match /topicMerges/{mergeId} {
        allow read: if canAccessProjectById(projectId);
        allow write: if false;
      }
    }

    match /users/{ownerUid}/records/{recordId} {
      allow create: if canCreateRecord(ownerUid, recordId);
      allow update: if canUpdateRecord(ownerUid, recordId);
      allow delete: if canDeleteRecord(ownerUid);

      match /audit/{auditId} {
        allow read: if isCurrentUser(ownerUid);
        allow create: if canCreateRecordAudit(ownerUid);
        allow update, delete: if false;
      }
    }

    // Necessário para collectionGroup('records'). Só concede leitura, nunca
    // escrita em registros alheios ou acesso recursivo às suas subcoleções.
    match /{path=**}/records/{recordId} {
      allow get, list: if canAccessRecordProject(resource.data);
    }

    // Perfis, OAuth, projeções e coleções não declaradas permanecem privados.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
