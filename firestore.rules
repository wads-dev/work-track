rules_version = '2';
// work and legacy missing-type projects are public to authenticated users.
// personal projects are private to createdBy. Full canonical record content is
// intentionally shared by CURRENT parent authorization, regardless of record uid.
// Prototype: review and verify with the emulator before broad deployment.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isWorkProject(data) { return !('type' in data) || data.type == 'work'; }
    function isPersonalProjectOwner(data) {
      return 'type' in data && data.type == 'personal'
        && data.createdBy is string && data.createdBy.size() > 0
        && data.createdBy.size() <= 128 && isOwner(data.createdBy);
    }
    function projectAccess(data) {
      return signedIn() && (isWorkProject(data) || isPersonalProjectOwner(data));
    }
    function validId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function recordProjectAccess(data) {
      return 'projectId' in data && validId(data.projectId)
        && exists(/databases/$(database)/documents/projects/$(data.projectId))
        && projectAccess(get(/databases/$(database)/documents/projects/$(data.projectId)).data);
    }
    function validProject(data, projectId) {
      return data.keys().hasAll(['id', 'title', 'description', 'createdBy', 'createdAt', 'topics'])
        && data.id == projectId && validId(projectId)
        && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128
        && (!('type' in data) || data.type in ['work', 'personal'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.description is string && data.description.size() >= 20 && data.description.size() <= 6000
        && data.createdAt is string && data.topics is list
        && (!('archived' in data) || data.archived is bool)
        && (!('confidential' in data) || data.confidential is bool);
    }
    function validRecord(data, uid, recordId) {
      return data.keys().hasAll(['uid', 'projectId', 'startedAt', 'timeZone', 'originalText', 'interpretation', 'requestId', 'fingerprint', 'topics'])
        && (!('id' in data) || data.id == recordId)
        && data.uid == uid && uid is string && uid.size() > 0 && uid.size() <= 128
        && validId(data.projectId) && validId(data.requestId)
        && data.fingerprint is string && data.fingerprint.size() > 0
        && data.startedAt is string && data.startedAt.size() >= 20 && data.startedAt.size() <= 40
        && (!('endedAt' in data) || data.endedAt == null || (data.endedAt is string && data.endedAt.size() >= 20 && data.endedAt.size() <= 40))
        && data.timeZone is string && data.timeZone.size() > 0 && data.timeZone.size() <= 100
        && data.originalText is string && data.originalText.size() > 0 && data.originalText.size() <= 12000
        && data.interpretation is string && data.interpretation.size() > 0 && data.interpretation.size() <= 6000
        && data.topics is list && data.topics.size() <= 30
        && (!('interruptions' in data) || (data.interruptions is list && data.interruptions.size() <= 30));
    }
    match /projects/{projectId} {
      // Query selectors: type == work; type == personal AND createdBy == uid.
      // Legacy missing-type projects are readable but cannot be selected with
      // type==work. Do not perform an unbounded unfiltered discovery query.
      allow get: if projectAccess(resource.data);
      // Absence of type cannot constrain a query's potential result set. Legacy
      // documents remain accessible by get, but discovery requires explicit type.
      allow list: if signedIn() && (resource.data.get('type', '') == 'work'
        || (resource.data.get('type', '') == 'personal'
          && resource.data.get('createdBy', '') == request.auth.uid));
      allow create: if signedIn() && 'type' in request.resource.data
        && validProject(request.resource.data, projectId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if projectAccess(resource.data) && projectAccess(request.resource.data)
        && validProject(request.resource.data, projectId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'type', 'createdBy', 'createdAt']);
      allow delete: if projectAccess(resource.data);
    }
    match /users/{uid}/records/{recordId} {
      allow create: if signedIn() && validId(recordId)
        && validRecord(request.resource.data, uid, recordId) && recordProjectAccess(request.resource.data);
      allow update: if recordProjectAccess(resource.data) && recordProjectAccess(request.resource.data)
        && resource.data.uid == uid && validRecord(request.resource.data, uid, recordId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'uid', 'requestId', 'fingerprint', 'receivedAt']);
      allow delete: if recordProjectAccess(resource.data) && resource.data.uid == uid;
      match /audit/{auditId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
    // Required for collectionGroup('records'). Only record documents whose
    // current parent is authorized are granted; no grant extends to their children.
    // Orphans and unauthorized current parents are denied, including record owners.
    match /{path=**}/records/{recordId} {
      allow get, list: if recordProjectAccess(resource.data);
    }
    // Profiles, OAuth, audits outside the explicit owner branch, projections and
    // all other paths remain denied. Never recursively inherit a project grant.
    match /{document=**} { allow read, write: if false; }
  }
}
