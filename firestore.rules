rules_version = '2';
// Assumed data model (all mutations are performed by the trusted Admin SDK):
// projects/{projectId}: id/title/description/createdBy/createdAt strings;
// topics list of {id,title,description}; recordedAt timestamp; optional
// updatedBy string and updatedAt timestamp. Shared organizational metadata only;
// do not store private transcripts, emails or user profiles in projects.
// users/{uid}/records/{recordId}: uid/projectId/requestId strings; startedAt,
// optional endedAt/commandAt ISO strings; timeZone/originalText/interpretation
// strings; topics/interruptions lists; recordedAt timestamp; fingerprint string.
// Company users may read canonical records (explicit organization sharing).
// Audit entries: authorUid/reason/updatedAt/before/after summaries, private to owner.
// oauth_* documents contain credentials and are never accessible to clients.
service cloud.firestore {
  match /databases/{database}/documents {
    function isCompanyGoogleUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^[^@]+@wads[.]dev$')
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /projects/{projectId} {
      allow read: if isCompanyGoogleUser();
      allow write: if false;
    }

    match /users/{uid}/records/{recordId} {
      allow read: if isCompanyGoogleUser();
      // Owner edits use callable/MCP transaction with audit; client writes denied.
      allow write: if false;
      match /audit/{auditId} {
        allow read: if isCompanyGoogleUser() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Only canonical records and owner audit have grants; user profiles/OAuth
    // and other nested paths remain denied. Rules are not
    // filters: cross-user collectionGroup('records') queries remain denied.
    // Client creates/updates/deletes stay denied; schemas are validated by API.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
