rules_version = '2';
// Web authorization only. MCP/Admin SDK operations bypass these rules normally.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validUid(uid) { return uid is string && uid.size() > 0 && uid.size() <= 128; }
    function validId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function isWorkProject(data) { return !('type' in data) || data.type == 'work'; }
    function projectAccess(data) {
      return signedIn() && (isWorkProject(data)
        || (data.get('type', '') == 'personal'
          && validUid(data.get('createdBy', '')) && isOwner(data.createdBy)));
    }
    function validProject(data, projectId) {
      return validId(projectId) && data.id == projectId
        && (isWorkProject(data)
          || (data.type == 'personal' && validUid(data.get('createdBy', ''))));
    }
    function recordProjectAccess(data) {
      return validId(data.get('projectId', ''))
        && exists(/databases/$(database)/documents/projects/$(data.projectId))
        && projectAccess(get(/databases/$(database)/documents/projects/$(data.projectId)).data);
    }
    function validRecord(data, uid, recordId) {
      return validId(recordId) && data.uid == uid
        && (!('id' in data) || data.id == recordId)
        && recordProjectAccess(data);
    }
    match /projects/{projectId} {
      allow get: if projectAccess(resource.data);
      // Legacy missing-type projects are accessible by get; discovery uses explicit type.
      allow list: if signedIn() && (resource.data.get('type', '') == 'work'
        || (resource.data.get('type', '') == 'personal'
          && resource.data.get('createdBy', '') == request.auth.uid));
      allow create: if signedIn() && validProject(request.resource.data, projectId)
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      // Authorize the CURRENT resource, not the destination: a public editor may
      // make it personal to its unchanged creator, then immediately lose access.
      allow update: if projectAccess(resource.data)
        && validProject(request.resource.data, projectId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'createdBy']);
      allow delete: if projectAccess(resource.data);
      match /audit/{auditId} {
        allow read: if projectAccess(get(/databases/$(database)/documents/projects/$(projectId)).data);
        // getAfter permits a batch changing scope even when the actor loses access.
        // Identity stays fixed and authorization is against the pre-write project.
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
          && validProject(getAfter(/databases/$(database)/documents/projects/$(projectId)).data, projectId)
          && ((!exists(/databases/$(database)/documents/projects/$(projectId))
              && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.createdBy == request.auth.uid)
            || (projectAccess(get(/databases/$(database)/documents/projects/$(projectId)).data)
              && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.get('createdBy', '')
                == get(/databases/$(database)/documents/projects/$(projectId)).data.get('createdBy', '')));
        allow update, delete: if false;
      }
      match /topicMerges/{mergeId} {
        allow read: if projectAccess(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow write: if false;
      }
    }
    match /users/{uid}/records/{recordId} {
      allow create: if isOwner(uid) && validRecord(request.resource.data, uid, recordId);
      allow update: if isOwner(uid) && resource.data.uid == uid
        && recordProjectAccess(resource.data) && validRecord(request.resource.data, uid, recordId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'uid']);
      allow delete: if isOwner(uid) && resource.data.uid == uid && recordProjectAccess(resource.data);
      match /audit/{auditId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
    // Collection-group reads use CURRENT project authorization, including records
    // owned by other users; snapshots never grant access to personal or orphan data.
    match /{path=**}/records/{recordId} {
      allow get, list: if recordProjectAccess(resource.data);
    }
    // Never recursively inherit grants into profiles, OAuth or projections.
    match /{document=**} { allow read, write: if false; }
  }
}
