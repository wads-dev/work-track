{
  "name": "@work-track/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prebuild": "npm run build:packages --prefix ../..",
    "build": "npm run build:modules && npm run package:functions",
    "build:modules": "tsc -p tsconfig.build.json",
    "package:functions": "node ../../scripts/package-functions.mjs",
    "pretypecheck": "npm run build:packages --prefix ../..",
    "pretest": "npm run build:packages --prefix ../..",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../scripts/build-vitest.config.mjs"
  },
  "dependencies": {
    "@work-track/core": "0.1.0",
    "@work-track/data": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  }
}
